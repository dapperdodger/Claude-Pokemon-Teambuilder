{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/regulation-phase.js 2>/dev/null || true",
            "statusMessage": "Checking regulation phase..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/vendor-staleness.js 2>/dev/null || true",
            "statusMessage": "Checking vendored data freshness..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check_sp_spread_optimization.js",
            "statusMessage": "Checking SP spread optimization..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/validate-team-file.js 2>/dev/null || true",
            "statusMessage": "Validating team file..."
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-mega-ability.js 2>/dev/null || true",
            "statusMessage": "Cross-checking Mega abilities against the local dex..."
          }
        ]
      }
    ]
  }
}
